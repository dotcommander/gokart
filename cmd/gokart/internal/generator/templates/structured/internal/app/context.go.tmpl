{{- if .HasIntegrations -}}
package app

import (
	"context"
	"errors"
	"fmt"
{{- if .UseSQLite }}
	"database/sql"
{{- end }}
	"log/slog"
	"os"
{{- if .UseSQLite }}
	"path/filepath"
{{- end }}
{{- if or .UseSQLite .UsePostgres }}
	"time"
{{- end }}
{{- if or .UseSQLite .UsePostgres .UseRedis }}
{{ end }}
{{- if .UsePostgres }}
	"github.com/jackc/pgx/v5/pgxpool"
{{- end }}
{{- if .UseRedis }}
	"github.com/redis/go-redis/v9"
{{- end }}
{{- if .UseSQLite }}
	_ "modernc.org/sqlite"
{{- end }}
{{- if .UseAI }}

	"github.com/openai/openai-go/v3"
	"github.com/openai/openai-go/v3/option"
{{- end }}

	"github.com/spf13/viper"
)

// Config key constants — single source of truth between viper defaults and readers.
const (
{{- if .UseSQLite }}
	AppConfigKeyDBPath       = "db_path"
{{- end }}
{{- if .UsePostgres }}
	AppConfigKeyDatabaseURL  = "database_url"
{{- end }}
{{- if .UseAI }}
	AppConfigKeyOpenAIAPIKey = "openai_api_key"
{{- end }}
{{- if .UseRedis }}
	AppConfigKeyRedisAddr    = "redis_addr"
{{- end }}
)

// Dependencies holds shared application dependencies.
type Dependencies struct {
	Log *slog.Logger
{{- if .UseSQLite }}
	DB  *sql.DB
{{- end }}
{{- if .UsePostgres }}
	Pool *pgxpool.Pool
{{- end }}
{{- if .UseAI }}
	AI  openai.Client
{{- end }}
{{- if .UseRedis }}
	Cache *redis.Client
{{- end }}
}

// Context is retained for commands generated by earlier GoKart releases.
type Context = Dependencies

// New creates application dependencies with config from viper.
func New(ctx context.Context, appName string, v *viper.Viper) (_ *Dependencies, err error) {
	logger := slog.New(slog.NewTextHandler(os.Stderr, &slog.HandlerOptions{Level: slog.LevelInfo}))

	appCtx := &Dependencies{
		Log: logger,
	}
	defer func() {
		if err == nil {
			return
		}
		if cleanupErr := appCtx.Close(); cleanupErr != nil {
			err = errors.Join(err, fmt.Errorf("close partially initialized dependencies: %w", cleanupErr))
		}
	}()
{{- if .UseSQLite }}

	// Setup SQLite database
	dbPath := v.GetString(AppConfigKeyDBPath)
	if dbPath == "" {
		cacheDir, err := os.UserCacheDir()
		if err != nil {
			return nil, err
		}
		dbDir := filepath.Join(cacheDir, appName)
		if err := os.MkdirAll(dbDir, 0755); err != nil {
			return nil, err
		}
		dbPath = filepath.Join(dbDir, "data.db")
	}

	// Pragmas mirror the gokart/sqlite defaults: WAL, foreign keys, 5s busy timeout.
	dsn := "file:" + dbPath + "?_txlock=immediate&_pragma=busy_timeout(5000)&_pragma=journal_mode(WAL)&_pragma=foreign_keys(1)&_pragma=cache_size(-2000)"
	db, err := sql.Open("sqlite", dsn)
	if err != nil {
		return nil, fmt.Errorf("open sqlite: %w", err)
	}
	db.SetMaxOpenConns(1)
	db.SetMaxIdleConns(1)
	db.SetConnMaxLifetime(time.Hour)
	if err := db.PingContext(ctx); err != nil {
		_ = db.Close()
		return nil, fmt.Errorf("ping sqlite: %w", err)
	}
	appCtx.DB = db
{{- end }}
{{- if .UsePostgres }}

	// Setup PostgreSQL connection pool
	dbURL := v.GetString(AppConfigKeyDatabaseURL)
	if dbURL == "" {
		dbURL = os.Getenv("DATABASE_URL")
	}
	if dbURL == "" {
		logger.Warn("DATABASE_URL not set, PostgreSQL features will not work")
	} else {
		poolCfg, err := pgxpool.ParseConfig(dbURL)
		if err != nil {
			return nil, fmt.Errorf("parse postgres config: %w", err)
		}
		poolCfg.MaxConns = 25
		poolCfg.MinConns = 5
		poolCfg.MaxConnLifetime = time.Hour
		poolCfg.MaxConnIdleTime = 30 * time.Minute
		poolCfg.HealthCheckPeriod = time.Minute
		pool, err := pgxpool.NewWithConfig(ctx, poolCfg)
		if err != nil {
			return nil, fmt.Errorf("connect to postgres: %w", err)
		}
		if err := pool.Ping(ctx); err != nil {
			pool.Close()
			return nil, fmt.Errorf("ping postgres: %w", err)
		}
		appCtx.Pool = pool
	}
{{- end }}
{{- if .UseAI }}

	// Setup OpenAI client
	apiKey := v.GetString(AppConfigKeyOpenAIAPIKey)
	if apiKey == "" {
		apiKey = os.Getenv("OPENAI_API_KEY")
	}
	if apiKey == "" {
		logger.Warn("OPENAI_API_KEY not set, AI features will not work")
	}
	appCtx.AI = openai.NewClient(option.WithAPIKey(apiKey))
{{- end }}
{{- if .UseRedis }}

	// Setup Redis cache
	redisAddr := v.GetString(AppConfigKeyRedisAddr)
	if redisAddr == "" {
		redisAddr = os.Getenv("REDIS_ADDR")
	}
	if redisAddr == "" {
		redisAddr = "localhost:6379"
	}
	cacheClient := redis.NewClient(&redis.Options{Addr: redisAddr})
	if err := cacheClient.Ping(ctx).Err(); err != nil {
		_ = cacheClient.Close()
		return nil, fmt.Errorf("ping redis: %w", err)
	}
	appCtx.Cache = cacheClient
{{- end }}

	return appCtx, nil
}

// Close releases resources.
func (c *Dependencies) Close() error {
	var cleanupErrors []error
	{{- if .UseSQLite }}
	if c.DB != nil {
		cleanupErrors = append(cleanupErrors, c.DB.Close())
	}
{{- end }}
{{- if .UsePostgres }}
	if c.Pool != nil {
		c.Pool.Close()
	}
{{- end }}
	{{- if .UseRedis }}
	if c.Cache != nil {
		cleanupErrors = append(cleanupErrors, c.Cache.Close())
	}
	{{- end }}
	return errors.Join(cleanupErrors...)
}
{{- end -}}
